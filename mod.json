{
  "geode": "5.11.2",
  "gd": {
    "ios": "2.2081"
  },
  "version": "v1.0.0",
  "id": "yourname.click-indicator",
  "name": "Click Indicator",
  "developer": "yourname",
  "description": "Affiche une image ON/OFF qui reagit instantanement aux clics du joueur. Images personnalisables, position libre.",
  "tags": ["utility", "gameplay", "interface"],
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Active",
      "default": true
    },
    "hidden": {
      "type": "bool",
      "name": "Masquer temporairement",
      "default": false
    },
    "scale": {
      "type": "float",
      "name": "Taille",
      "default": 1.0,
      "min": 0.1,
      "max": 4.0,
      "control": {
        "slider": true,
        "input": true
      }
    },
    "opacity": {
      "type": "float",
      "name": "Opacite",
      "default": 1.0,
      "min": 0.1,
      "max": 1.0,
      "control": {
        "slider": true,
        "input": true
      }
    }
  },
  "resources": {
    "sprites": [
      "resources/*.png"
    ]
  }
}
